<Window x:Class="HermesAgent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Agent 控制台"
        Width="1240"
        Height="780"
        MinWidth="1040"
        MinHeight="680"
        Background="#EEF2F6"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9E1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="MetricPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#1D4ED8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Background" Value="#B42318"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B42318"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#243244"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Hermes Agent 控制台" FontSize="30" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock Text="原生 Windows 管理端：启动、更新、网关、日志和本地配置入口" Margin="0,5,0,0" Foreground="#5B6778"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="LastRefreshText" Text="尚未刷新" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,14,0"/>
        <Button Content="立即刷新" Click="Refresh_Click" Style="{StaticResource FlatButton}" MinWidth="96"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="运行控制" FontSize="19" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="这些操作直接控制本机 Hermes 进程。" Margin="0,5,0,16" Foreground="#667085" TextWrapping="Wrap"/>

            <Button x:Name="StartButton" Content="启动控制台后端" Click="StartDashboard_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
            <Button x:Name="StopButton" Content="停止控制台后端" Click="StopDashboard_Click" Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
            <Button x:Name="RestartButton" Content="重启消息网关" Click="RestartGateway_Click" Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
            <Button x:Name="UpdateButton" Content="打开终端执行更新" Click="UpdateHermes_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Margin="0,0,0,18"/>

            <TextBlock Text="连接设置" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="0,4,0,10"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="端口" VerticalAlignment="Center" Foreground="#475467" Margin="0,0,10,0"/>
              <TextBox x:Name="PortBox" Grid.Column="1" Text="9119" MinHeight="34"/>
              <Button Grid.Column="2" Content="应用" Click="ApplyPort_Click" Style="{StaticResource FlatButton}" Margin="8,0,0,0" MinWidth="70"/>
            </Grid>

            <TextBlock Text="仓库目录" Foreground="#475467" Margin="0,2,0,6"/>
            <TextBox x:Name="RepoRootBox" MinHeight="34" TextWrapping="NoWrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
              <Button Content="应用目录" Click="ApplyRepo_Click" Style="{StaticResource FlatButton}" MinWidth="96"/>
              <Button Content="打开目录" Click="OpenRepo_Click" Style="{StaticResource FlatButton}" MinWidth="96"/>
            </StackPanel>

            <TextBlock Text="本地文件" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="0,4,0,10"/>
            <UniformGrid Columns="2" Rows="3">
              <Button Content="打开配置" Click="OpenConfig_Click" Style="{StaticResource FlatButton}" Margin="0,0,7,8"/>
              <Button Content="打开密钥" Click="OpenEnv_Click" Style="{StaticResource FlatButton}" Margin="7,0,0,8"/>
              <Button Content="日志目录" Click="OpenLogs_Click" Style="{StaticResource FlatButton}" Margin="0,0,7,8"/>
              <Button Content="复制地址" Click="CopyUrl_Click" Style="{StaticResource FlatButton}" Margin="7,0,0,8"/>
              <Button Content="打开网页" Click="OpenDashboard_Click" Style="{StaticResource FlatButton}" Margin="0,0,7,0"/>
              <Button Content="清空日志框" Click="ClearLog_Click" Style="{StaticResource FlatButton}" Margin="7,0,0,0"/>
            </UniformGrid>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0">
            <TextBlock x:Name="HintText" Text="就绪" Foreground="#475467" TextWrapping="Wrap"/>
          </Border>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <TextBlock Text="控制台后端" Foreground="#667085"/>
              <TextBlock x:Name="DashboardBadgeText" Text="未知" FontSize="24" FontWeight="SemiBold" Foreground="#111827" Margin="0,8,0,0"/>
              <TextBlock x:Name="DashboardSubText" Text="-" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <TextBlock Text="消息网关" Foreground="#667085"/>
              <TextBlock x:Name="GatewayBadgeText" Text="未知" FontSize="24" FontWeight="SemiBold" Foreground="#111827" Margin="0,8,0,0"/>
              <TextBlock x:Name="GatewaySubText" Text="-" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <TextBlock Text="活跃会话" Foreground="#667085"/>
              <TextBlock x:Name="SessionsText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#111827" Margin="0,8,0,0"/>
              <TextBlock Text="最近 5 分钟" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}" Margin="0">
            <StackPanel>
              <TextBlock Text="版本" Foreground="#667085"/>
              <TextBlock x:Name="VersionText" Text="未知" FontSize="24" FontWeight="SemiBold" Foreground="#111827" Margin="0,8,0,0"/>
              <TextBlock x:Name="PortText" Text="端口 9119" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="运行详情" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
              <TextBlock x:Name="DetailText" Text="等待状态..." Foreground="#475467" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="AutoRefreshBox" Grid.Column="1" Content="自动刷新" IsChecked="True" VerticalAlignment="Top" Foreground="#475467" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DashboardLogButton" Content="控制台日志" Click="DashboardLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                <Button x:Name="GatewayLogButton" Content="网关日志" Click="GatewayLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                <Button x:Name="UpdateLogButton" Content="更新日志" Click="UpdateLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                <Button x:Name="RestartLogButton" Content="重启日志" Click="RestartLog_Click" Style="{StaticResource FlatButton}"/>
              </StackPanel>
              <TextBlock x:Name="LogTitleText" Grid.Column="1" Text="控制台日志" VerticalAlignment="Center" Foreground="#667085"/>
            </Grid>
            <TextBox x:Name="LogTextBox"
                     Margin="14,0,14,14"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#101828"
                     Foreground="#E5E7EB"
                     BorderThickness="0"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="FooterText" Text="本机模式，密钥不会显示在界面中。" Foreground="#667085" Margin="2,12,0,0"/>
  </Grid>
</Window>
