<Window x:Class="HermesAgent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Agent"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        Background="#F3F5F8"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D8E0EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#1455D9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1455D9"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Background" Value="#B42318"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B42318"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#253247"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Hermes Agent" FontSize="30" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock Text="原生 Windows 客户端：聊天、模型、密钥、更新和日志都在这里。" Margin="0,5,0,0" Foreground="#5B6778"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="LastRefreshText" Text="尚未刷新" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,14,0"/>
        <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource FlatButton}" MinWidth="82"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="本机状态" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="控制台后端" Foreground="#667085" Margin="0,16,0,4"/>
            <TextBlock x:Name="DashboardBadgeText" Text="未知" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="DashboardSubText" Text="-" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="消息网关" Foreground="#667085" Margin="0,10,0,4"/>
            <TextBlock x:Name="GatewayBadgeText" Text="未知" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="GatewaySubText" Text="-" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="当前模型" Foreground="#667085" Margin="0,10,0,4"/>
            <TextBlock x:Name="CurrentModelText" Text="未读取" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Text="版本：未知" Foreground="#667085" Margin="0,14,0,0"/>
            <TextBlock x:Name="PortText" Text="端口：9119" Foreground="#667085" Margin="0,4,0,18"/>
            <Button x:Name="StartButton" Content="启动后端" Click="StartDashboard_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button x:Name="InstallButton" Content="一键安装 / 修复" Click="InstallRepair_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button x:Name="UpdateButton" Content="终端更新" Click="UpdateHermes_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Text="就绪" Foreground="#475467" TextWrapping="Wrap" Margin="0,18,0,0"/>
        </DockPanel>
      </Border>

      <TabControl Grid.Column="2" Background="Transparent">
        <TabItem Header="聊天">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="在线聊天" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ChatStatusText" Text="连接后端后即可开始对话。" Foreground="#667085" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="ConnectChatButton" Content="连接聊天" Click="ConnectChat_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                  <Button Content="清空" Click="ClearChat_Click" Style="{StaticResource FlatButton}"/>
                </StackPanel>
              </Grid>
            </Border>
            <ListBox x:Name="ChatList" Grid.Row="1" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" Padding="8"/>
            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ChatInputBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              <Button x:Name="SendChatButton" Grid.Column="1" Content="发送" Click="SendChat_Click" Style="{StaticResource PrimaryButton}" MinWidth="98" Margin="10,0,0,0"/>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="模型">
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="模型切换" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="保存后对新会话生效；当前聊天可新建连接后使用。" Foreground="#667085" TextWrapping="Wrap" Margin="0,5,0,16"/>
                <TextBlock Text="提供商" Foreground="#475467" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModelProviderCombo" MinHeight="34" DisplayMemberPath="Name" SelectionChanged="ModelProviderCombo_SelectionChanged"/>
                <TextBlock Text="模型" Foreground="#475467" Margin="0,14,0,6"/>
                <ComboBox x:Name="ModelCombo" MinHeight="34" IsEditable="True"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="读取模型" Click="RefreshModels_Click" Style="{StaticResource FlatButton}" MinWidth="96"/>
                  <Button Content="保存切换" Click="SaveModel_Click" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ModelStatusText" Text="后端在线后会自动拉取可用模型。" Foreground="#667085" TextWrapping="Wrap" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="可用提供商" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ListBox x:Name="ProviderList" DisplayMemberPath="Name"/>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="密钥">
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="430"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="API 密钥" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="密钥写入本机 Hermes 环境文件，不会显示明文。" Foreground="#667085" TextWrapping="Wrap" Margin="0,5,0,16"/>
                <TextBlock Text="提供商" Foreground="#475467" Margin="0,0,0,6"/>
                <ComboBox x:Name="ProviderCombo" MinHeight="34" SelectionChanged="ProviderCombo_SelectionChanged"/>
                <TextBlock Text="API Key" Foreground="#475467" Margin="0,14,0,6"/>
                <PasswordBox x:Name="ApiKeyBox" MinHeight="34"/>
                <TextBlock x:Name="BaseUrlLabel" Text="Base URL（New API / One API）" Foreground="#475467" Margin="0,14,0,6"/>
                <TextBox x:Name="BaseUrlBox" MinHeight="34"/>
                <TextBlock x:Name="BaseUrlHintText" Text="填写你的 New API 地址，例如 http://127.0.0.1:3000/v1 或 https://你的域名/v1。" Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="保存密钥" Click="SaveKey_Click" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                  <Button Content="打开密钥文件" Click="OpenEnv_Click" Style="{StaticResource FlatButton}" MinWidth="116" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="KeyStatusText" Text="选择提供商后粘贴 API Key。" Foreground="#667085" TextWrapping="Wrap" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="说明" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="OpenAI、Anthropic、Gemini、DeepSeek、OpenRouter、小米、New API / One API 等常用入口都在左侧。New API 和小米同级，不再单独乱放。" Foreground="#475467" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="运行 / 日志">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="运行控制" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DetailText" Text="等待状态..." Foreground="#475467" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button x:Name="StopButton" Content="停止后端" Click="StopDashboard_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                  <Button x:Name="RestartButton" Content="重启网关" Click="RestartGateway_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                  <Button Content="打开网页" Click="OpenDashboard_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                  <CheckBox x:Name="AutoRefreshBox" Content="自动刷新" IsChecked="True" VerticalAlignment="Center" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="控制台日志" Click="DashboardLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                    <Button Content="网关日志" Click="GatewayLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                    <Button Content="更新日志" Click="UpdateLog_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                    <Button Content="打开目录" Click="OpenLogs_Click" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                    <Button Content="清空" Click="ClearLog_Click" Style="{StaticResource FlatButton}"/>
                  </StackPanel>
                  <TextBlock x:Name="LogTitleText" Grid.Column="1" Text="控制台日志" VerticalAlignment="Center" Foreground="#667085"/>
                </Grid>
                <TextBox x:Name="LogTextBox"
                         Margin="14,0,14,14"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#101828"
                         Foreground="#E5E7EB"
                         BorderThickness="0"/>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="设置">
          <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
            <StackPanel Width="560" HorizontalAlignment="Left">
              <TextBlock Text="连接设置" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="端口" Foreground="#475467" Margin="0,16,0,6"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PortBox" Text="9119" MinHeight="34" Width="140"/>
                <Button Content="应用端口" Click="ApplyPort_Click" Style="{StaticResource FlatButton}" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="仓库目录" Foreground="#475467" Margin="0,16,0,6"/>
              <TextBox x:Name="RepoRootBox" MinHeight="34"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="应用目录" Click="ApplyRepo_Click" Style="{StaticResource FlatButton}" MinWidth="96"/>
                <Button Content="打开目录" Click="OpenRepo_Click" Style="{StaticResource FlatButton}" MinWidth="96" Margin="8,0,0,0"/>
                <Button Content="复制地址" Click="CopyUrl_Click" Style="{StaticResource FlatButton}" MinWidth="96" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="FooterText" Text="本机模式，密钥不会显示在界面中。" Foreground="#667085" Margin="2,12,0,0"/>
  </Grid>
</Window>
