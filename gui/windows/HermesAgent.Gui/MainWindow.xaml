<Window x:Class="HermesAgent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Agent"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Hermes Agent" FontSize="28" FontWeight="SemiBold" Foreground="#141922"/>
        <TextBlock Text="Native Windows control panel" Margin="0,3,0,0" Foreground="#5E6775"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#47515F"/>
        <TextBox x:Name="PortBox" Width="78" Text="9119"/>
        <Button Content="Apply" Click="ApplyPort_Click" Margin="8,0,0,0" MinWidth="72"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

          <Button Content="Start Dashboard" Click="StartDashboard_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
          <Button Content="Stop Dashboard" Click="StopDashboard_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
          <Button Content="Restart Gateway" Click="RestartGateway_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
          <Button Content="Update Hermes" Click="UpdateHermes_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

          <Separator Margin="0,0,0,14"/>

          <TextBlock Text="Repository" FontWeight="SemiBold" Foreground="#2B3340"/>
          <TextBox x:Name="RepoRootBox" Margin="0,7,0,8" TextWrapping="NoWrap"/>
          <Button Content="Use Path" Click="ApplyRepo_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

          <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#2B3340"/>
          <Border Background="#F7F9FB" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,7,0,0">
            <StackPanel>
              <TextBlock x:Name="DashboardStatusText" Text="Dashboard: unknown" Margin="0,0,0,5"/>
              <TextBlock x:Name="GatewayStatusText" Text="Gateway: unknown" Margin="0,0,0,5"/>
              <TextBlock x:Name="VersionText" Text="Version: unknown" Margin="0,0,0,5"/>
              <TextBlock x:Name="SessionsText" Text="Active sessions: 0"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="HintText"
                     TextWrapping="Wrap"
                     Foreground="#697384"
                     Margin="0,16,0,0"
                     Text="This app controls the local Hermes backend. It does not embed the web dashboard."/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="DetailText" Text="Waiting for status..." Foreground="#5E6775" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,8">
              <Button x:Name="DashboardLogButton" Content="Dashboard Log" Click="DashboardLog_Click"/>
              <Button x:Name="GatewayLogButton" Content="Gateway Log" Click="GatewayLog_Click"/>
              <Button x:Name="UpdateLogButton" Content="Update Log" Click="UpdateLog_Click"/>
              <Button x:Name="RestartLogButton" Content="Restart Log" Click="RestartLog_Click"/>
            </StackPanel>
            <TextBox x:Name="LogTextBox"
                     Margin="12,0,12,12"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#0F141B"
                     Foreground="#D7DEE8"
                     BorderThickness="0"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
